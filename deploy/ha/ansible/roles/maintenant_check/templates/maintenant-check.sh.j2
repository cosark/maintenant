#!/bin/sh
# The application test the OpenSVC service runs against the binary.
#
#   0  alive     HTTP 200 within the deadline and storage.connected true
#   1  degraded  HTTP 200 within the deadline and storage.connected false
#   2  dead      no answer within the deadline, or any other status
#
# /api/v1/health answers 200 whatever the state of the storage, so the body is
# what decides. It also carries runtime.connected: only storage.connected counts.
#
# A dead result is logged under {{ maintenant_check_log_identifier }}, unless --quiet is given.

set -u

url="{{ maintenant_check_url }}"
deadline={{ maintenant_check_timeout_seconds }}

quiet=no
if [ "${1:-}" = --quiet ]; then
	quiet=yes
fi

dead() {
	[ "$quiet" = yes ] || logger -t {{ maintenant_check_log_identifier }} -- "event=check_dead reason=$1"
	exit 2
}

body=$(curl -fsS -m "$deadline" "$url" 2>/dev/null) || dead no_answer
connected=$(printf '%s' "$body" | jq -r 'if .storage.connected == null then "absent" else .storage.connected end' 2>/dev/null) || dead unreadable_body

case "$connected" in
true) exit 0 ;;
false)
	echo "storage not connected" >&2
	exit 1
	;;
*)
	echo "health body carries no storage.connected" >&2
	dead no_storage_connected
	;;
esac
