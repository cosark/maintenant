#!/bin/sh
# Stops every instance of the binary the service account runs.

set -u

user="{{ maintenant_user }}"
name="{{ maintenant_bin | basename }}"

pkill -TERM -u "$user" -x "$name"
n=0
while pgrep -u "$user" -x "$name" >/dev/null && [ "$n" -lt {{ maintenant_start_term_wait_seconds * 10 }} ]; do
	sleep 0.1
	n=$((n + 1))
done
pkill -KILL -u "$user" -x "$name"
sleep 0.1

if pgrep -u "$user" -x "$name" >/dev/null; then
	logger -t {{ maintenant_check_log_identifier }} -- "event=stop_failed"
	exit 1
fi
logger -t {{ maintenant_check_log_identifier }} -- "event=stopped"
